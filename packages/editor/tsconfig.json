{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@vasa/extension-table": ["../extension-table/src/index.ts"],
      "@vasa/layout": ["../layout/src/index.ts"],
      "@vasa/pdf": ["../pdf/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["src", "react"]
}
