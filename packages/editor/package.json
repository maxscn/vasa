{
  "name": "@opeinspection/skriva",
  "version": "0.0.0",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./canvas": "./dist/canvas.mjs",
    "./enrichment": "./dist/enrichment.mjs",
    "./enrichments/horizontal-rule": "./dist/enrichments/horizontal-rule.mjs",
    "./enrichments/line-height": "./dist/enrichments/line-height.mjs",
    "./enrichments/svg": "./dist/enrichments/svg.mjs",
    "./enrichments/table": "./dist/enrichments/table.mjs",
    "./font": "./dist/font.mjs",
    "./headless": "./dist/headless.mjs",
    "./layout": "./dist/layout.mjs",
    "./pdf": "./dist/pdf.mjs",
    "./react": "./dist/react.mjs",
    "./renderer": "./dist/renderer.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
