    "@skriva/extension-color": "workspace:*",
    "@skriva/extension-document": "workspace:*",
    "@skriva/extension-font-family": "workspace:*",
    "@skriva/extension-font-size": "workspace:*",
    "@skriva/extension-heading": "workspace:*",
    "@skriva/extension-highlight": "workspace:*",
    "@skriva/extension-horizontal-rule": "workspace:*",
    "@skriva/extension-italic": "workspace:*",
    "@skriva/extension-line-height": "workspace:*",
    "@skriva/extension-paragraph": "workspace:*",
    "@skriva/extension-strike": "workspace:*",
    "@skriva/extension-subscript": "workspace:*",
    "@skriva/extension-superscript": "workspace:*",
    "@skriva/extension-svg": "workspace:*",
    "@skriva/extension-table": "workspace:*",
    "@skriva/extension-text": "workspace:*",
