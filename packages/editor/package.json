{
  "name": "@vasa/editor",
  "version": "0.0.0",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@tiptap/react": "catalog:",
    "@vasa/canvas": "workspace:*",
    "@vasa/core": "workspace:*",
    "@vasa/extension-blockquote": "workspace:*",
    "@vasa/extension-bold": "workspace:*",
    "@vasa/extension-code": "workspace:*",
    "@vasa/extension-color": "workspace:*",
    "@vasa/extension-document": "workspace:*",
    "@vasa/extension-font-family": "workspace:*",
    "@vasa/extension-font-size": "workspace:*",
    "@vasa/extension-heading": "workspace:*",
    "@vasa/extension-highlight": "workspace:*",
    "@vasa/extension-horizontal-rule": "workspace:*",
    "@vasa/extension-italic": "workspace:*",
    "@vasa/extension-line-height": "workspace:*",
    "@vasa/extension-paragraph": "workspace:*",
    "@vasa/extension-strike": "workspace:*",
    "@vasa/extension-subscript": "workspace:*",
    "@vasa/extension-superscript": "workspace:*",
    "@vasa/extension-svg": "workspace:*",
    "@vasa/extension-table": "workspace:*",
    "@vasa/extension-text": "workspace:*",
    "@vasa/extension-text-style": "workspace:*",
    "@vasa/extension-underline": "workspace:*",
    "@vasa/font": "workspace:*",
    "@vasa/layout": "workspace:*",
    "@vasa/pdf": "workspace:*",
    "@vasa/renderer": "workspace:*",
    "lucide-react": "^0.545.0",
    "pdfjs-dist": "catalog:",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14"
