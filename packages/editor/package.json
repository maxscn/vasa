    "@skriva/layout": "workspace:*",
    "@skriva/pdf": "workspace:*",
    "@skriva/renderer": "workspace:*",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "lucide-react": "^0.545.0",
    "pdfjs-dist": "catalog:",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-state": "^1.4.4",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14"
