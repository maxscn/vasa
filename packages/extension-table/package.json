{
  "name": "@skriva/extension-table",
  "version": "0.0.0",
  "description": "Table node extension for Skriva.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
